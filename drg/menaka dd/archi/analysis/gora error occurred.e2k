$ ANALYSIS OPTIONS
  ACTIVEDOF "UX UY UZ RX RY RZ"  
  MODELHINGESINLINKS "Yes"  HINGEDAMPINGOPTION "KT"  
  PDELTA  METHOD "NONE"  
  AUTOMESHOPTIONS  MESHTYPE  "GENERAL"  FLOORMESHMAXSIZE  1250 WALLMESHMAXSIZE  1250 

$ MASS SOURCE
  MASSSOURCE  "MsSrc1"    INCLUDEELEMENTS "No"    INCLUDEADDEDMASS "Yes"    INCLUDELOADS "Yes"    INCLUDEMOVE "No"    INCLUDELATERALMASS "Yes"    INCLUDEVERTICALMASS "No"    LUMPATSTORIES "Yes"    ISDEFAULT "Yes"  
  MASSSOURCELOAD  "MsSrc1"  "Dead"  1 
  MASSSOURCELOAD  "MsSrc1"  "Live"  0.3 
  MASSSOURCELOAD  "MsSrc1"  "9"" wall"  1 
  MASSSOURCELOAD  "MsSrc1"  "partition wall"  1 
  MASSSOURCELOAD  "MsSrc1"  "FF"  1 
  MASSSOURCELOAD  "MsSrc1"  "staircase steps"  1 
  MASSSOURCELOAD  "MsSrc1"  "stair live"  0.3 
  MASSSOURCELOAD  "MsSrc1"  "water tank"  0.6 

$ FUNCTIONS
  FUNCTION "RampTH"  FUNCTYPE "HISTORY"  HISTTYPE "USER"  
  FUNCTION "RampTH"  TIMEVAL "0  0  1  1  4  1"  
  FUNCTION "UnifTH"  FUNCTYPE "HISTORY"  HISTTYPE "USER"  
  FUNCTION "UnifTH"  TIMEVAL "0  1  1  1"  
  FUNCTION "UnifRS"  FUNCTYPE "SPECTRUM"  DAMPRATIO 0.05  SPECTYPE "USER"  
  FUNCTION "UnifRS"  TIMEVAL "0  1  1  1"  
  FUNCTION "UnifPSD"  FUNCTYPE "POWERSPECDENSITY"  PSDTYPE "USER"    FREQUNIT "HZ"  
  FUNCTION "UnifPSD"  TIMEVAL "0  1  1  1"  
  FUNCTION "UnifSS"  FUNCTYPE "STEADYSTATE"  SSTYPE "USER"    FREQUNIT "HZ"  
  FUNCTION "UnifSS"  TIMEVAL "0  1  1  1"  

